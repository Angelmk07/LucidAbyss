  - m_Id: 44859469824
    m_Localized: " \u041F\u0440\u0438\u0432\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 202523357184
    m_Localized: "\u041A\u0430\u043A \u0434\u0435\u043B\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 13600489287680
    m_Localized: "\u041F\u0435\u0440\u0435\u0434 \u0432\u0430\u043C\u0438 4 \u043A\u0440\u0430\u0441\u043D\u044B\u0445
      \u043A\u0440\u0443\u0433\u0430 \u0441 \u0446\u0438\u0444\u0440\u0430\u043C\u0438.
      \u0412\u0430\u043C \u043D\u0443\u0436\u043D\u043E \u0431\u044B\u0441\u0442\u0440\u043E
      \u043D\u0430\u0436\u0430\u0442\u044C \u043D\u0430 \u044D\u0442\u0438 \u043A\u0440\u0443\u0433\u0438
      \u0432 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0439 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438.
      \u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0430\u044F \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0430 \u0446\u0438\u0444\u0440\u0430\u043C\u0438
      \u043D\u0430 \u043A\u0440\u0443\u0433\u0430\u0445. \u0423\u0441\u043F\u0435\u0439\u0442\u0435
      \u043D\u0430\u0436\u0430\u0442\u044C \u043D\u0430 \u043A\u0440\u0443\u0433\u0438
      \u0432 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0439 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
      \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u0438\u0441\u0442\u0435\u0447\u0435\u0442
      \u0432\u0440\u0435\u043C\u044F.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 34976466022400
    m_Localized: "\u041C\u043D\u0435 \u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F
      \u0442\u0443\u0442... \u042D\u0442\u043E \u043C\u0435\u0441\u0442\u043E \u0432\u043E\u043E\u0431\u0449\u0435
      \u043C\u043E\u0436\u0435\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0432\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 35016697786368
    m_Localized: "\u0411\u043E\u0436\u0435, \u044D\u0442\u043E \u043A\u0440\u043E\u0432\u044C?!
      \u042F \u0442\u0430\u043A \u0445\u043E\u0447\u0443 \u0434\u043E\u043C\u043E\u0439..."
    m_Metadata:
      m_Items: []
  - m_Id: 35030828396544
    m_Localized: "\u0418 \u0432\u043D\u043E\u0432\u044C \u0432\u0441\u0451 \u0432\u043E\u043A\u0440\u0443\u0433
      \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u043E\u0441\u044C... \u0422\u0443\u0442
      \u0442\u0430\u043A \u043E\u0434\u0438\u043D\u043E\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35044346638336
    m_Localized: "\u041D\u0430 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u044D\u0442\u043E
      \u043D\u0435 \u0441\u043E\u043D! \u041D\u0435 \u0441\u043E\u043D... \u0414\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 35054178086912
    m_Localized: "\u041D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E \u044F
      \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F! \u041C\u043E\u0436\u0435\u0442
      \u0431\u044B\u0442\u044C..."
    m_Metadata:
      m_Items: []
